{
  "name": "pm-cli",
  "version": "0.0.1",
  "description": "Professional Package Manager CLI for npm, pnpm, and bun",
  "type": "module",
  "bin": {
    "pm": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile pm.exe",
    "link": "bun run src/index.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ora": "^5.4.1",
    "table": "^6.8.1",
    "commander": "^11.1.0",
    "zod": "^3.22.4",
    "clipboardy": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
